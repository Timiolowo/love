# Create a Gemini API key in Google AI Studio and keep it server-side.
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted when GEMINI_API_KEY is not set.
# GOOGLE_API_KEY=

# Stable default selected for structured chat analysis and rewriting.
GEMINI_MODEL=gemini-2.5-flash

# Optional: the official API base URL or an exact :generateContent endpoint.
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Cloudflare API Token for Cloudflare MCP
CLOUDFLARE_API_TOKEN=

# Paystack API Keys for Payments
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Google OAuth Credentials for Google Sign-In
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here
